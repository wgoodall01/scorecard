          "value": "(\"job\".\"state\" = 'queued' AND \"job\".\"result\" IS NULL AND \"job\".\"error\" IS NULL)\n        OR (\"job\".\"state\" = 'working' AND \"job\".\"result\" IS NULL AND \"job\".\"error\" IS NULL)\n        OR (\"job\".\"state\" = 'ok' AND \"job\".\"result\" IS NOT NULL AND \"job\".\"error\" IS NULL)\n        OR (\"job\".\"state\" = 'error' AND \"job\".\"result\" IS NULL AND \"job\".\"error\" IS NOT NULL)"
        },
