{
  "name": "scorecard",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "pkg/*"
  ],
  "scripts": {
    "dev": "bun --filter api dev",
    "dev:web": "bun --filter web dev",
    "build": "bun --filter web build",
    "typecheck": "bun run --workspaces typecheck",
    "predeploy": "bun run build && bun db:migrate:remote",
    "deploy": "bun run build && bunx wrangler deploy",
    "db:generate": "bun --filter api db:generate",
    "db:migrate:local": "bun --filter api db:migrate:local",
    "db:migrate:remote": "bun --filter api db:migrate:remote"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "type": "module",
  "devDependencies": {
    "wrangler": "^4.111.0"
  }
}
